#!/bin/bash

# ASND - AssetSonar Network Discovery
# Version: 1.0.0
# Maintainer: EZO AssetSonar <support@assetsonar.com>

# Configuration file path
CONFIG_FILE="/etc/asnd/config.ini"

# Function to display help
show_help() {
    echo "ASND - AssetSonar Network Discovery"
    echo ""
    echo "Usage: asnd [COMMAND] [OPTIONS]"
    echo ""
    echo "Commands:"
    echo "  config <subdomain> <token>    Configure ASND with subdomain and token"
    echo "  init                         Initialize ASND (requires config to be set up)"
    echo "  --help                       Show this help message"
    echo ""
    echo "Examples:"
    echo "  asnd config mysubdomain mytoken123"
    echo "  asnd init"
    echo "  asnd --help"
    echo ""
    echo "AssetSonar Network Discovery is a package used to setup network discovery"
    echo "server on any on-premises server. It communicates with AssetSonar to sync"
    echo "network devices data."
    echo ""
    echo "Maintained by: EZO AssetSonar <support@assetsonar.com>"
}

# Function to create config directory
create_config_dir() {
    local config_dir=$(dirname "$CONFIG_FILE")
    if [[ ! -d "$config_dir" ]]; then
        sudo mkdir -p "$config_dir"
        sudo chown root:root "$config_dir"
        sudo chmod 755 "$config_dir"
    fi
}

# Function to save configuration
save_config() {
    local subdomain="$1"
    local token="$2"
    local device_id="$3"
    
    create_config_dir
    
    # Create INI configuration
    cat > /tmp/asnd_config.ini << EOF
[Assetsonar]
url = https://${subdomain}.assetsonar.com
tag = ${device_id}

[OpenAudit]
sync_enabled = true
url = http://localhost/open-audit/index.php
username = admin
password = password
system_id = ${device_id}
EOF
    
    # Move to final location with proper permissions
    sudo mv /tmp/asnd_config.ini "$CONFIG_FILE"
    sudo chown root:root "$CONFIG_FILE"
    sudo chmod 600 "$CONFIG_FILE"
    
    echo "Configuration saved successfully!"
}

# Function to read existing configuration
read_existing_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        # Extract device_id from INI config (from either Assetsonar tag or OpenAudit system_id)
        local device_id
        device_id=$(grep -E "^(tag|system_id)[[:space:]]*=" "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d'=' -f2 | tr -d ' ')
        echo "$device_id"
    else
        echo ""
    fi
}

# Function to verify configuration with AssetSonar
verify_config() {
    local subdomain="$1"
    local token="$2"
    
    echo "Verifying configuration with AssetSonar..."
    
    # Check for existing device_id
    local existing_device_id
    existing_device_id=$(read_existing_config)
    
    # Make POST request to verify endpoint
    local url="https://${subdomain}.assetsonar.com/api/api_integration/verify_network_discovery"
    local response_code
    local response_body
    
    # Create JSON payload with nd_access_token and optionally device_id
    local json_payload
    if [[ -n "$existing_device_id" ]]; then
        json_payload="{\"nd_access_token\": \"$token\", \"device_id\": \"$existing_device_id\"}"
        echo "Using existing device_id: $existing_device_id"
    else
        json_payload="{\"nd_access_token\": \"$token\"}"
    fi
    
    # Make the request and capture both response code and body
    local temp_file=$(mktemp)
    response_code=$(curl -s -w "%{http_code}" \
        -X POST \
        -H "Content-Type: application/json" \
        -d "$json_payload" \
        -o "$temp_file" \
        "$url")
    
    if [[ "$response_code" == "200" ]]; then
        # Parse device_id from response
        local device_id
        device_id=$(cat "$temp_file" | grep -o '"device_id"[[:space:]]*:[[:space:]]*"[^"]*"' | cut -d'"' -f4)
        
        if [[ -n "$device_id" ]]; then
            echo "Configuration verified successfully! Device ID: $device_id"
            echo "$device_id"  # Return device_id for saving
            rm -f "$temp_file"
            return 0
        else
            echo "Configuration verification failed: No device_id in response"
            rm -f "$temp_file"
            return 1
        fi
    else
        echo "Configuration verification failed (HTTP $response_code)"
        rm -f "$temp_file"
        return 1
    fi
}

# Function to check if config file exists and is valid
check_config_exists() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        echo "Error: Configuration file not found at $CONFIG_FILE"
        echo "Please run 'asnd config <subdomain> <token>' first to configure ASND"
        return 1
    fi
    
    # Basic validation - check if file has required sections
    if ! grep -q "^\[Assetsonar\]" "$CONFIG_FILE" || ! grep -q "^\[OpenAudit\]" "$CONFIG_FILE"; then
        echo "Error: Configuration file is invalid or corrupted"
        echo "Please run 'asnd config <subdomain> <token>' to reconfigure ASND"
        return 1
    fi
    
    return 0
}

# Function to handle init command
handle_init() {
    echo "Initializing ASND..."
    
    # Check if config file exists and is valid
    if ! check_config_exists; then
        exit 1
    fi
    
    echo "Configuration file found and valid"
    
    # Setup OpenAudit
    echo "Setting up OpenAudit..."
    if [[ -f "setup.sh" ]]; then
        echo "Running OpenAudit setup script..."
        if bash setup.sh; then
            echo "OpenAudit setup completed successfully"
        else
            echo "Error: OpenAudit setup failed with non-zero exit status"
            exit 1
        fi
    else
        echo "Error: OpenAudit setup script (setup.sh) not found"
        exit 1
    fi
    
    # Setup AssetSonar connector for OpenAudit
    echo "Setting up AssetSonar connector for OpenAudit..."
    
    # Install required dependencies
    echo "Installing required dependencies (ruby-full, build-essential, and bundler gem)..."
    if command -v apt-get >/dev/null 2>&1; then
        # Debian/Ubuntu system
        if sudo apt-get update && sudo apt-get install -y ruby-full build-essential; then
            echo "System dependencies installed successfully"
            
            # Install bundler gem
            echo "Installing bundler gem..."
            if gem install bundler; then
                echo "Bundler gem installed successfully"
            else
                echo "Error: Failed to install bundler gem"
                exit 1
            fi
        else
            echo "Error: Failed to install system dependencies"
            exit 1
        fi
    else
        echo "Error: Unsupported system. This package requires Debian/Ubuntu with apt-get"
        exit 1
    fi
    
    # Setup AssetSonar connector (files already installed by package)
    echo "Setting up AssetSonar connector..."
    
    # Check if connector files exist (installed by package)
    if [[ ! -d "/opt/assetsonar-connector" ]]; then
        echo "Error: AssetSonar connector not found. Please reinstall the package."
        exit 1
    fi
    
    # Remove existing cron jobs
    echo "Removing existing cron jobs..."
    crontab -l 2>/dev/null | grep -v '/opt/assetsonar-connector' | crontab -
    
    # Setup cron jobs
    echo "Setting up cron jobs..."
    command_sync="/opt/assetsonar-connector/bin/assetsonar_syncer -s"
    command_execute="/opt/assetsonar-connector/bin/assetsonar_syncer -e"
    
    # Add sync cron job (every hour)
    eval "crontab -l 2>/dev/null | { cat; echo '0 * * * * $command_sync'; } | crontab -"
    
    # Add execute cron job (every hour)
    eval "crontab -l 2>/dev/null | { cat; echo '0 * * * * $command_execute'; } | crontab -"
    
    echo "AssetSonar connector setup completed successfully"
    echo "ASND initialization completed successfully"
}

# Function to handle config command
handle_config() {
    if [[ $# -lt 2 ]]; then
        echo "Error: config command requires subdomain and token"
        echo "Usage: asnd config <subdomain> <token>"
        exit 1
    fi
    
    local subdomain="$1"
    local token="$2"
    
    # Validate subdomain (basic validation)
    if [[ ! "$subdomain" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]*[a-zA-Z0-9]$ ]]; then
        echo "Error: Invalid subdomain format"
        exit 1
    fi
    
    # Validate token (basic validation - not empty)
    if [[ -z "$token" ]]; then
        echo "Error: Token cannot be empty"
        exit 1
    fi
    
    # Verify configuration and capture device_id
    local device_id
    device_id=$(verify_config "$subdomain" "$token")
    local verify_exit_code=$?
    
    if [[ $verify_exit_code -eq 0 && -n "$device_id" ]]; then
        save_config "$subdomain" "$token" "$device_id"
    else
        echo "Configuration discarded due to verification failure"
        exit 1
    fi
}

# Parse command line arguments
if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

case "$1" in
    config)
        shift
        handle_config "$@"
        ;;
    init)
        shift
        handle_init "$@"
        ;;
    --help)
        show_help
        exit 0
        ;;
    *)
        echo "Unknown command: $1"
        echo "Use --help for usage information"
        exit 1
        ;;
esac
